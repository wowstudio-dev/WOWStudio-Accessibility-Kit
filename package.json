{
	"name": "wowstudio-accessibility-kit",
	"version": "0.5.1",
	"description": "Helps you find, fix, document, and monitor WCAG accessibility issues in WordPress at the code level.",
	"author": "WOWStudio",
	"license": "GPL-2.0-or-later",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "wp-scripts start --webpack-src-dir=assets/src --output-path=build",
		"build": "wp-scripts build --webpack-src-dir=assets/src --output-path=build",
		"lint:js": "wp-scripts lint-js assets/src",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.scss\"",
		"format": "wp-scripts format",
		"packages-update": "wp-scripts packages-update",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"makepot": "bin/makepot.sh",
		"plugin-check": "bin/build.sh && wp-env run cli --env-cwd=wp-content/plugins/wowstudio-accessibility-kit wp plugin check dist/wowstudio-accessibility-kit --exclude-directories=freemius --format=table",
		"dist": "bin/build.sh",
		"dist:zip": "bin/build.sh --zip",
		"dist:free": "bin/build.sh --free",
		"dist:free:zip": "bin/build.sh --free --zip",
		"fs:reset": "bin/reset-freemius.sh"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/dom-ready": "^4.53.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/env": "^11.13.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/icons": "^15.4.0",
		"@wordpress/scripts": "^34.1.0"
	}
}
