includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- src
		- bin
		- wowstudio-accessibility-kit.php
		- uninstall.php
	bootstrapFiles:
		- tests/constants.php
	# Loads Freemius SDK symbols without analysing the vendored SDK itself.
	scanDirectories:
		- freemius/includes
	scanFiles:
		- freemius/start.php
		# WordPress 7.0's AI Client; the bundled WP stubs still describe 6.9.
		- stubs/wp-ai-client.php
	treatPhpDocTypesAsCertain: false
