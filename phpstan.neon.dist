includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- src
		- bin
		- wowstudio-accessibility-kit.php
	bootstrapFiles:
		- tests/constants.php
	scanDirectories:
		# Action Scheduler's API is global functions, declared in a bundled
		# library we do not analyse. Scanned so calls to it resolve.
		- vendor/woocommerce/action-scheduler
	scanFiles:
		# WordPress 7.0's AI Client; the bundled WP stubs still describe 6.9.
		- stubs/wp-ai-client.php
		# WP-CLI is the environment src/Cli/ may run inside, never a dependency.
		- stubs/wp-cli.php
		# Elementor is a plugin this one may run beside; every reach into it is
		# guarded at runtime because none of it is guaranteed to be present.
		- stubs/elementor.php
	treatPhpDocTypesAsCertain: false
