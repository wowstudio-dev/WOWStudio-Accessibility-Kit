# Dependencies, rebuilt at release time.
/vendor/
/node_modules/

# Build output.
/build/
/dist/
/languages/*.mo
/languages/*.l10n.php

# Tool caches.
.phpunit.result.cache
.phpcs-cache
/wp-env/

# OS and editor noise.
.DS_Store
Thumbs.db
*.log


# Local dev-server config for the design preview. Points at generated files, so
# it is one developer's convenience rather than something to share.
/.claude/launch.json
/.wp-env.override.json
