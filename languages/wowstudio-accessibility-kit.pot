msgstr ""

#: src/Scanner/BrowserRules.php:97
msgid "This area scrolls, but nothing inside it can be focused, so somebody using a keyboard rather than a mouse can never scroll it and cannot read whatever is out of sight. Give the container tabindex=\"0\", and an accessible name so it announces as something meaningful when focus lands on it."
msgstr ""

#: src/Scanner/BrowserRules.php:101
msgid "The container needs tabindex and an accessible name. The attribute is mechanical; the name is a description of what is inside, and both live in the theme."
msgstr ""

#: src/Scanner/BrowserRules.php:103
msgid "Anyone using a keyboard rather than a mouse can never scroll this, so whatever is out of sight stays out of reach."
msgstr ""

#: src/Scanner/BrowserRules.php:110
msgid "Element is hidden from screen readers but still focusable"
msgstr ""

#: src/Scanner/BrowserRules.php:111
msgid "This element is marked aria-hidden=\"true\", so a screen reader will not describe it, but it can still receive keyboard focus. The result is a focus stop that announces nothing — the user tabs, something happens, and there is no way to tell what. Either remove aria-hidden or take the element out of the tab order."
msgstr ""

#: src/Scanner/BrowserRules.php:115
msgid "Either the element should be revealed or it should leave the tab order, and only somebody who knows why it is hidden can say which."
msgstr ""

#: src/Scanner/BrowserRules.php:117
msgid "Keyboard users land on something that announces nothing. Focus moves and there is no way to tell where it went."
msgstr ""

#: src/Scanner/Detection.php:42
#: assets/src/components/tags.js:34
msgid "Auto-detected"
msgstr ""

#: src/Scanner/Detection.php:43
#: assets/src/components/tags.js:35
msgid "Needs manual review"
msgstr ""

#: src/Scanner/FetchStrategy.php:57
msgid "Whole page"
msgstr ""

#: src/Scanner/FetchStrategy.php:58
msgid "Content only"
msgstr ""

#: src/Scanner/IssueStatus.php:43
msgid "Open"
msgstr ""

#: src/Scanner/IssueStatus.php:44
#: assets/src/components/overview.js:279
msgid "Fixed"
msgstr ""

#: src/Scanner/IssueStatus.php:45
msgid "Ignored"
msgstr ""

#: src/Scanner/PageScanner.php:136
msgid "The page could not be parsed as HTML, so it could not be scanned."
msgstr ""

#: src/Scanner/PageSource.php:102
msgid "that content has no public address"
msgstr ""

#: src/Scanner/PageSource.php:110
msgid "this site cannot make requests to itself"
msgstr ""

#. translators: %d: HTTP status code.
#: src/Scanner/PageSource.php:135
#, php-format
msgid "the page returned HTTP %d"
msgstr ""

#: src/Scanner/PageSource.php:144
msgid "the page returned no content"
msgstr ""

#: src/Scanner/PageSource.php:183
msgid "This checked the content of the page, not the theme around it. Faults in your header, navigation and footer are reported separately, against the theme, rather than repeated against every page that uses it."
msgstr ""

#. translators: %s: the underlying reason.
#: src/Scanner/PageSource.php:215
#, php-format
msgid "The page could not be fetched for scanning because %s. This usually means the site cannot make requests to itself; ask your host about loopback requests."
msgstr ""

#. translators: %s: the underlying reason the whole page could not be fetched.
#: src/Scanner/PageSource.php:243
#, php-format
msgid "Only this content was scanned, not the whole page, because %s. Checks that depend on the surrounding page — its language, its title, its landmarks — were skipped, so this scan covers less than usual. Ask your host about loopback requests to enable full-page scanning."
msgstr ""

#: src/Scanner/PageSource.php:310
msgid "There was nothing to check: this page's content field is empty, and no page builder supplied anything either. If visitors do see content here, something is producing it that this scan cannot reach — reaching it means fetching the whole page, so ask your host about loopback requests or whether a security plugin is blocking them."
msgstr ""

#: src/Scanner/Rules/AriaReferenceBroken.php:116
msgid "ARIA attribute points at an element that does not exist"
msgstr ""

#: src/Scanner/Rules/AriaReferenceBroken.php:127
msgid "This element names another element by id, and nothing on the page has that id. The reference resolves to nothing, and in most browsers a broken aria-labelledby also suppresses the name the element would otherwise have had — so the markup looks like an accessibility improvement while leaving the control anonymous. Correct the id, or remove the attribute."
msgstr ""

#: src/Scanner/Rules/AriaReferenceBroken.php:138
msgid "The element loses the name it was meant to have, and often the one it already had."
msgstr ""

#: src/Scanner/Rules/AriaReferenceBroken.php:153
msgid "Which element was meant to be pointed at is something only whoever wrote the markup knows. These attributes are usually emitted by a theme or a plugin template rather than typed into your content."
msgstr ""

#. translators: 1: the ARIA attribute name. 2: the ids it points at that do not exist, comma separated.
#: src/Scanner/Rules/AriaReferenceBroken.php:191
#, php-format
msgid "This element's %1$s points at %2$s, and nothing on the page has that id."
msgstr ""

#: src/Scanner/Rules/AudioNeedsTranscript.php:96
msgid "Audio needs a transcript"
msgstr ""

#: src/Scanner/Rules/AudioNeedsTranscript.php:107
msgid "This page plays audio, and audio has only one alternative: a transcript of what is said. Nothing in the markup distinguishes a transcript from any other text, so this cannot be checked automatically — it is here as a prompt. If there is already a transcript on the page, mark this as reviewed and it will not ask again."
msgstr ""

#: src/Scanner/Rules/AudioNeedsTranscript.php:118
msgid "Anybody who cannot hear the recording has no way to get at what it says."
msgstr ""

#: src/Scanner/Rules/AudioNeedsTranscript.php:133
msgid "Publish the transcript as text on the page, near the player. Nothing here can tell a transcript from any other paragraph, so this will keep asking until you mark it reviewed."
msgstr ""

#: src/Scanner/Rules/AudioNeedsTranscript.php:158
msgid "This page plays audio. Check that a transcript is published with it."
msgstr ""

#: src/Scanner/Rules/BoldTextAsHeading.php:116
msgid "Bold text may be standing in for a heading"
msgstr ""

#: src/Scanner/Rules/BoldTextAsHeading.php:127
msgid "This paragraph is entirely bold, short, and has no closing punctuation, which usually means it is a section title formatted by hand rather than marked as a heading. It looks like a heading and is not one, so it does not appear in the list of headings screen reader users navigate by, and the page has no outline where it appears to have one. If it is a heading, change the block type to a heading."
msgstr ""

#: src/Scanner/Rules/BoldTextAsHeading.php:138
msgid "The page looks structured but has no outline, so there is nothing to navigate by."
msgstr ""

#: src/Scanner/Rules/BoldTextAsHeading.php:153
msgid "Whether this is a section title or simply an emphasised line is a judgement about what the page says. If it is a title, change the block from paragraph to heading and pick the level that fits the ones around it."
msgstr ""

#. translators: %s: the bold text.
#: src/Scanner/Rules/BoldTextAsHeading.php:220
#, php-format
msgid "\"%s\" is a whole paragraph in bold, which often means a heading formatted by hand."
msgstr ""

#: src/Scanner/Rules/ButtonNameMissing.php:87
msgid "Button has no accessible name"
msgstr ""

#: src/Scanner/Rules/ButtonNameMissing.php:98
msgid "Someone using a screen reader hears only \"button\" and cannot tell what it does. Icon-only buttons need an aria-label, or visually hidden text describing the action."
msgstr ""

#: src/Scanner/Rules/ButtonNameMissing.php:109
msgid "A screen reader announces this as “button” and nothing else, so there is no way to tell what it does."
msgstr ""

#: src/Scanner/Rules/ButtonNameMissing.php:124
msgid "A button's name has to describe what it does, which means knowing what it does. Edit the button in the content."
msgstr ""

#: src/Scanner/Rules/ButtonNameMissing.php:153
msgid "This button has no text or label, so its purpose is not announced."
msgstr ""

#: src/Scanner/Rules/DocumentTitleMissing.php:86
msgid "Page has no title"
msgstr ""

#: src/Scanner/Rules/DocumentTitleMissing.php:97
msgid "The page title is the first thing a screen reader announces, and the label people see in browser tabs, bookmarks, and search results. Give the page a title that describes what is on it."
msgstr ""

#: src/Scanner/Rules/DocumentTitleMissing.php:108
msgid "Browser tabs, bookmarks and search results have nothing to show for this page but its address."
msgstr ""

#: src/Scanner/Rules/DocumentTitleMissing.php:123
msgid "WordPress writes the title itself once the theme declares support for it, and a plugin can declare that support on the theme's behalf before wp_loaded. One right answer, and somewhere to put it."
msgstr ""

#: src/Scanner/Rules/DocumentTitleMissing.php:153
msgid "The page has no title element."
msgstr ""

#: src/Scanner/Rules/DocumentTitleMissing.php:154
msgid "The page title is empty."
msgstr ""

#: src/Scanner/Rules/DuplicateId.php:99
msgid "The same id is used more than once"
msgstr ""

#: src/Scanner/Rules/DuplicateId.php:110
msgid "Two or more elements on this page share an id. Labels, ARIA references, in-page links and scripts all resolve an id to the first match, so everything pointing at the later ones silently reaches the wrong element instead — a second form field with the same id cannot be labelled at all. Usually this comes from a template being rendered twice on one page."
msgstr ""

#: src/Scanner/Rules/DuplicateId.php:121
msgid "Labels and ARIA references reach the wrong element, so the later ones are left unnamed."
msgstr ""

#: src/Scanner/Rules/DuplicateId.php:136
msgid "Which copy should be renamed depends on what is emitting them, which is usually a template or a block rendered more than once rather than something typed into your content."
msgstr ""

#. translators: %s: the id that appears more than once.
#: src/Scanner/Rules/DuplicateId.php:189
#, php-format
msgid "The id \"%s\" is used on more than one element, so anything pointing at it reaches only the first."
msgstr ""

#: src/Scanner/Rules/FormControlLabelMissing.php:88
msgid "Form field has no label"
msgstr ""

#: src/Scanner/Rules/FormControlLabelMissing.php:99
msgid "This field is not labelled, so someone using a screen reader cannot tell what to type into it. Add a <label for> pointing at the field, or an aria-label. Placeholder text does not count."
msgstr ""

#: src/Scanner/Rules/FormControlLabelMissing.php:110
msgid "Anyone using a screen reader arrives at this field and is never told what to put in it."
msgstr ""

#: src/Scanner/Rules/FormControlLabelMissing.php:125
msgid "What a field should be called is a judgement about what it is asking for. Label it wherever the form is built — usually the form plugin rather than the page."
msgstr ""

#. translators: %s: form field name attribute, or the element name.
#: src/Scanner/Rules/FormControlLabelMissing.php:173
#, php-format
msgid "The form field \"%s\" has no label."
msgstr ""

#: src/Scanner/Rules/FormLabelOrphaned.php:103
msgid "Form label is attached to the wrong thing"
msgstr ""

#: src/Scanner/Rules/FormLabelOrphaned.php:114
msgid "A label here either points at a field that does not exist, or a single field has been given two labels. Both look correct on screen and neither is: an unattached label leaves the field announced as blank and stops clicking the label from focusing it, and two labels produce a name that differs between browsers and screen readers. Point the label's for attribute at the field's id, and use exactly one."
msgstr ""

#: src/Scanner/Rules/FormLabelOrphaned.php:125
msgid "The field is announced without its name, or with a different name depending on the software used."
msgstr ""

#: src/Scanner/Rules/FormLabelOrphaned.php:140
msgid "Which field a label belongs to, and which of two labels is the right one, are questions about the form rather than the markup. Forms are usually built by a plugin, so the fix is normally in that plugin's form editor."
msgstr ""

#. translators: %s: the id the label points at.
#: src/Scanner/Rules/FormLabelOrphaned.php:183
#, php-format
msgid "A label points at the id \"%s\", and no field on this page has it."
msgstr ""

#. translators: 1: the label text. 2: the id the label points at.
#: src/Scanner/Rules/FormLabelOrphaned.php:188
#, php-format
msgid "The label \"%1$s\" points at the id \"%2$s\", and no field on this page has it."
msgstr ""

#. translators: %s: the id shared by both labels.
#: src/Scanner/Rules/FormLabelOrphaned.php:210
#, php-format
msgid "The field \"%s\" has more than one label, so which name a reader hears depends on their browser."
msgstr ""

#: src/Scanner/Rules/HeadingEmpty.php:98
msgid "Heading is empty"
msgstr ""

#: src/Scanner/Rules/HeadingEmpty.php:109
msgid "This heading contains no text, so a screen reader announces a heading and then nothing. People who navigate by jumping between headings get a stop on that route that tells them nothing about where they are. Either give the heading text, or remove it — an empty heading is usually left over from editing."
msgstr ""

#: src/Scanner/Rules/HeadingEmpty.php:120
msgid "Anyone navigating by headings lands on one that announces nothing."
msgstr ""

#: src/Scanner/Rules/HeadingEmpty.php:135
msgid "Whether this heading wants text or wants deleting depends on why it is there, which is a question about the page. Both are edits in the editor."
msgstr ""

#. translators: %s: the heading element name, for example h2.
#: src/Scanner/Rules/HeadingEmpty.php:169
#, php-format
msgid "This %s contains no text."
msgstr ""

#: src/Scanner/Rules/HeadingLevelSkipped.php:88
msgid "Heading level is skipped"
msgstr ""

#: src/Scanner/Rules/HeadingLevelSkipped.php:99
msgid "People using a screen reader navigate by moving through headings, so the levels need to descend one step at a time. Jumping a level makes the page outline look like a section is missing. Change the heading level, or add the missing intermediate heading."
msgstr ""

#: src/Scanner/Rules/HeadingLevelSkipped.php:110
msgid "Most screen reader users move around a page by jumping between headings. This one leaves a gap in that path."
msgstr ""

#: src/Scanner/Rules/HeadingLevelSkipped.php:125
msgid "Renumbering the heading is one possible fix; the other is that a section is genuinely missing and should be written. Choosing between those is a judgement about the document, not a correction to it."
msgstr ""

#. translators: 1: heading level the theme appears to establish, 2: this heading level.
#: src/Scanner/Rules/HeadingLevelSkipped.php:178
#, php-format
msgid "Your theme appears to put a level %1$d heading above your content, which would make this level %2$d a jump. Worth checking on the page itself."
msgstr ""

#. translators: 1: previous heading level, 2: this heading level.
#: src/Scanner/Rules/HeadingLevelSkipped.php:184
#, php-format
msgid "This heading jumps from level %1$d to level %2$d."
msgstr ""

#: src/Scanner/Rules/HtmlLangMissing.php:87
msgid "Page language is not set"
msgstr ""

#: src/Scanner/Rules/HtmlLangMissing.php:98
msgid "The page does not say what language it is written in, so a screen reader may read it with the wrong pronunciation. Set a lang attribute on the html element, such as lang=\"en\"."
msgstr ""

#: src/Scanner/Rules/HtmlLangMissing.php:109
msgid "A screen reader may read the whole page in the wrong accent, which can make it genuinely hard to follow."
msgstr ""

#: src/Scanner/Rules/HtmlLangMissing.php:124
msgid "The right value is known — it is the site's own language setting — but the html element is printed by the theme and no filter reaches it. Knowing the answer is not the same as being able to write it, which is why this is a hand-off rather than a button."
msgstr ""

#: src/Scanner/Rules/HtmlLangMissing.php:157
msgid "The page does not declare a language."
msgstr ""

#: src/Scanner/Rules/IframeTitleMissing.php:87
msgid "Frame has no title"
msgstr ""

#: src/Scanner/Rules/IframeTitleMissing.php:98
msgid "Screen readers let people jump between frames on a page, but an untitled frame shows up in that list with no name. Add a title attribute describing what the frame contains, such as the name of an embedded video."
msgstr ""

#: src/Scanner/Rules/IframeTitleMissing.php:109
msgid "Anyone moving through the page by its regions meets this embedded content with no idea what it is."
msgstr ""

#: src/Scanner/Rules/IframeTitleMissing.php:124
msgid "The title has to describe what is embedded, which means looking at it. Add a title attribute to the iframe in the content."
msgstr ""

#: src/Scanner/Rules/IframeTitleMissing.php:153
msgid "This frame has no title, so it is announced without a name."
msgstr ""

#: src/Scanner/Rules/ImageAltIsFilename.php:146
msgid "Alt text is a file name or a placeholder"
msgstr ""

#: src/Scanner/Rules/ImageAltIsFilename.php:157
msgid "The alt attribute is filled in, but with the file name or a placeholder word rather than a description. This is worse than leaving it empty in one specific way: it looks answered, so nothing else will flag it. Replace it with what the image tells the reader, or with alt=\"\" if the image is decorative."
msgstr ""

#: src/Scanner/Rules/ImageAltIsFilename.php:168
msgid "A screen reader reads the file name aloud, letter by letter, in place of what the picture shows."
msgstr ""

#: src/Scanner/Rules/ImageAltIsFilename.php:183
msgid "What the image conveys depends on why it is on the page, so the wording is yours. The Images screen is the quickest route: it lists undescribed images with a field beside each, and what you write goes to the media library."
msgstr ""

#. translators: %s: the alt text found on the image.
#: src/Scanner/Rules/ImageAltIsFilename.php:247
#, php-format
msgid "The alt text is a file name: \"%s\"."
msgstr ""

#. translators: %s: the alt text found on the image.
#: src/Scanner/Rules/ImageAltIsFilename.php:255
#, php-format
msgid "The alt text is \"%s\", which describes nothing about this particular image."
msgstr ""

#. translators: %s: the alt text found on the image.
#: src/Scanner/Rules/ImageAltIsFilename.php:273
#, php-format
msgid "The alt text repeats the image file name: \"%s\"."
msgstr ""

#: src/Scanner/Rules/ImageAltMissing.php:90
msgid "Image has no alt attribute"
msgstr ""

#: src/Scanner/Rules/ImageAltMissing.php:101
msgid "Someone using a screen reader gets nothing useful from this image, and often hears the file name read out instead. Add alt text describing what the image conveys, or alt=\"\" if it is purely decorative and should be skipped."
msgstr ""

#: src/Scanner/Rules/ImageAltMissing.php:112
msgid "Anyone using a screen reader hears the file name read out instead of what the picture shows."
msgstr ""

#: src/Scanner/Rules/ImageAltMissing.php:127
msgid "A description of a photograph is not something a rule can compute — it depends on why the image is on the page, which only you know. The Alt text screen lists every undescribed image so you can write them in one pass. What you write goes to the media library, so it applies wherever that image is used and survives this plugin being removed."
msgstr ""

#: src/Scanner/Rules/ImageAltMissing.php:155
msgid "This image has no alt attribute."
msgstr ""

#. translators: %s: image file name.
#: src/Scanner/Rules/ImageAltMissing.php:158
#, php-format
msgid "The image \"%s\" has no alt attribute."
msgstr ""

#: src/Scanner/Rules/ImageAltRedundant.php:95
msgid "Alt text repeats the caption or title"
msgstr ""

#: src/Scanner/Rules/ImageAltRedundant.php:106
msgid "This image's alt text is word-for-word the same as its caption or its title attribute, so a screen reader announces the same sentence twice in a row. Either describe the image differently in the alt — what it shows, rather than what the caption already says about it — or mark it decorative with alt=\"\" and let the caption do the work."
msgstr ""

#: src/Scanner/Rules/ImageAltRedundant.php:117
msgid "The same sentence is announced twice in a row to anyone listening to the page."
msgstr ""

#: src/Scanner/Rules/ImageAltRedundant.php:132
msgid "Which of the two should change depends on what each is for: the caption is usually the context, the alt is usually what the picture shows. Sometimes the right answer is an empty alt."
msgstr ""

#: src/Scanner/Rules/ImageAltRedundant.php:162
msgid "This image's alt text and title attribute are identical, so both are announced."
msgstr ""

#: src/Scanner/Rules/ImageAltRedundant.php:177
msgid "This image's alt text is word-for-word its caption, so the same sentence is announced twice."
msgstr ""

#: src/Scanner/Rules/ImageAltTooLong.php:113
msgid "Alt text may be too long to listen to"
msgstr ""

#: src/Scanner/Rules/ImageAltTooLong.php:124
msgid "Alt text is announced in one run, with no way to pause it, skim it or go back a sentence. Anything this long is usually content the page itself should carry — in a caption, or a paragraph beside the image — where everyone can read it and anyone can navigate it. Consider shortening the alt to what the image conveys at a glance and moving the detail onto the page."
msgstr ""

#: src/Scanner/Rules/ImageAltTooLong.php:135
msgid "Someone using a screen reader has to sit through a paragraph they cannot pause, skim or re-read."
msgstr ""

#: src/Scanner/Rules/ImageAltTooLong.php:150
msgid "Whether this detail belongs in the alt text or on the page is a question about the content, and sometimes the long version is right. Shorten it in the media library if it is not."
msgstr ""

#. translators: 1: how many characters the alt text is. 2: the length at which this rule starts reporting.
#: src/Scanner/Rules/ImageAltTooLong.php:184
#, php-format
msgid "This alt text is %1$d characters long; anything over about %2$d is usually better as a caption or a paragraph."
msgstr ""

#: src/Scanner/Rules/ImageMapAreaAltMissing.php:97
msgid "Image map region has no alt text"
msgstr ""

#: src/Scanner/Rules/ImageMapAreaAltMissing.php:108
msgid "A clickable region of an image map is a link, and an area element has nowhere to put visible text — its alt attribute is the only name it can have. Without one, a screen reader announces the raw URL or nothing at all. Add an alt attribute naming where the region goes."
msgstr ""

#: src/Scanner/Rules/ImageMapAreaAltMissing.php:119
msgid "A screen reader reaches a link it cannot name, and reads out the URL instead of the destination."
msgstr ""

#: src/Scanner/Rules/ImageMapAreaAltMissing.php:134
msgid "Naming the region means knowing which part of the picture it covers and where it goes, which is a question about the map rather than the markup. Add an alt attribute to each area."
msgstr ""

#: src/Scanner/Rules/ImageMapAreaAltMissing.php:172
msgid "This image map region has no alt text."
msgstr ""

#. translators: %s: the URL the region links to.
#: src/Scanner/Rules/ImageMapAreaAltMissing.php:175
#, php-format
msgid "The image map region linking to %s has no alt text."
msgstr ""

#: src/Scanner/Rules/InputImageAltMissing.php:94
msgid "Image button has no alt text"
msgstr ""

#: src/Scanner/Rules/InputImageAltMissing.php:105
msgid "This is a submit button drawn as an image, and it has no alt attribute. There is nowhere else to put its name, so a screen reader announces it as an unnamed button or reads out the file name. Anybody who cannot see the picture has to press it to find out what it does. Add an alt attribute saying what the button does — \"Search\", not \"magnifying glass\"."
msgstr ""

#: src/Scanner/Rules/InputImageAltMissing.php:116
msgid "A button that submits something is announced without a name, so its purpose can only be discovered by pressing it."
msgstr ""

#: src/Scanner/Rules/InputImageAltMissing.php:131
msgid "The alt should say what the button does rather than what the picture is — \"Search\" rather than \"magnifying glass\". Only you know which."
msgstr ""

#: src/Scanner/Rules/InputImageAltMissing.php:167
msgid "This image button has no alt text, so it is announced without a name."
msgstr ""

#: src/Scanner/Rules/LinkAnchorBroken.php:110
msgid "In-page link points at nothing"
msgstr ""

#: src/Scanner/Rules/LinkAnchorBroken.php:121
msgid "This link jumps to a part of the page that does not exist, so activating it does nothing at all — focus stays where it was, with no error and no message. If it is a skip link, keyboard users are tabbing through your whole header on every page. Either give the target element the matching id, or correct the link."
msgstr ""

#: src/Scanner/Rules/LinkAnchorBroken.php:132
msgid "The link does nothing when activated, and nothing says so — focus simply stays put."
msgstr ""

#: src/Scanner/Rules/LinkAnchorBroken.php:147
msgid "Two ends, and only you know which one moved: either the target lost its id, or the link points at the wrong name. Skip links and their targets almost always live in the theme header rather than in your content."
msgstr ""

#. translators: %s: the fragment the link points at, including the hash.
#: src/Scanner/Rules/LinkAnchorBroken.php:197
#, php-format
msgid "A link points to %s, but nothing on this page has that id."
msgstr ""

#. translators: 1: the link text. 2: the fragment the link points at, including the hash.
#: src/Scanner/Rules/LinkAnchorBroken.php:202
#, php-format
msgid "The link \"%1$s\" points to %2$s, but nothing on this page has that id."
msgstr ""

#: src/Scanner/Rules/LinkNameMissing.php:88
msgid "Link has no accessible name"
msgstr ""

#: src/Scanner/Rules/LinkNameMissing.php:99
msgid "This link announces nothing, so someone using a screen reader hears only \"link\" and cannot tell where it goes. Add visible text, an aria-label, or alt text on the image inside it."
msgstr ""

#: src/Scanner/Rules/LinkNameMissing.php:110
msgid "A screen reader announces this as “link” and nothing else, so there is no way to tell where it goes."
msgstr ""

#: src/Scanner/Rules/LinkNameMissing.php:125
msgid "A link's name has to describe where it goes, which nothing here can know. Edit the link in the content."
msgstr ""

#. translators: %s: link target.
#: src/Scanner/Rules/LinkNameMissing.php:156
#, php-format
msgid "The link to \"%s\" has no text or label."
msgstr ""

#: src/Scanner/Rules/LinkNotKeyboardReachable.php:110
msgid "Clickable link cannot be reached by keyboard"
msgstr ""

#: src/Scanner/Rules/LinkNotKeyboardReachable.php:121
msgid "This element does something when clicked, but it has no href, so the browser does not treat it as a link. It cannot be tabbed to, it does not appear in a screen reader's list of links, and pressing Enter on it does nothing. Give it a real href if it goes somewhere, or make it a button element if it performs an action."
msgstr ""

#: src/Scanner/Rules/LinkNotKeyboardReachable.php:132
msgid "Anyone not using a mouse cannot reach this control at all — it does not exist for them."
msgstr ""

#: src/Scanner/Rules/LinkNotKeyboardReachable.php:147
msgid "Which element it should be depends on what it does: somewhere to go is a link with a real href, something to happen is a button. Both are keyboard-operable for free; a div or a bare anchor never is."
msgstr ""

#: src/Scanner/Rules/LinkNotKeyboardReachable.php:186
msgid "This element responds to a click but has no href, so the keyboard cannot reach it."
msgstr ""

#. translators: %s: the element's text.
#: src/Scanner/Rules/LinkNotKeyboardReachable.php:189
#, php-format
msgid "\"%s\" responds to a click but has no href, so the keyboard cannot reach it."
msgstr ""

#: src/Scanner/Rules/LinkOpensNewWindow.php:119
msgid "Link opens a new tab without saying so"
msgstr ""

#: src/Scanner/Rules/LinkOpensNewWindow.php:130
msgid "This link opens in a new tab, and nothing in its text or title says it will. A new tab removes the back button, which is a quiet problem for a sighted user and a confusing one for somebody who cannot see that a tab opened. Either say so in the link text — \"(opens in a new tab)\" — or let the link open normally and leave the choice to the reader."
msgstr ""

#: src/Scanner/Rules/LinkOpensNewWindow.php:141
msgid "The reader lands somewhere new with no announcement, and pressing Back does nothing."
msgstr ""

#: src/Scanner/Rules/LinkOpensNewWindow.php:156
msgid "Two possible answers, and choosing between them is an editorial call: add the warning to the link text, or stop opening a new tab. Both are edits to the link in your content."
msgstr ""

#: src/Scanner/Rules/LinkOpensNewWindow.php:205
msgid "This link opens in a new tab and does not say so."
msgstr ""

#. translators: %s: the link text.
#: src/Scanner/Rules/LinkOpensNewWindow.php:208
#, php-format
msgid "The link \"%s\" opens in a new tab and does not say so."
msgstr ""

#: src/Scanner/Rules/LinkTextNotDescriptive.php:90
msgid "Link text may not make sense on its own"
msgstr ""

#: src/Scanner/Rules/LinkTextNotDescriptive.php:101
msgid "Screen reader users often browse a list of every link on the page, with no surrounding text. Phrases like 'read more' or 'click here' give them nothing to go on. Consider rewriting the link to name its destination. If the wording is genuinely clear in context, mark this as reviewed."
msgstr ""

#: src/Scanner/Rules/LinkTextNotDescriptive.php:112
msgid "Screen reader users often pull up a list of every link on a page. In that list, this one says nothing about where it goes."
msgstr ""

#: src/Scanner/Rules/LinkTextNotDescriptive.php:127
msgid "Better wording depends on where the link goes and what the sentence around it already says. Rewrite the link text in the content."
msgstr ""

#. translators: %s: the link text.
#: src/Scanner/Rules/LinkTextNotDescriptive.php:183
#, php-format
msgid "The link text \"%s\" may not make sense when read on its own."
msgstr ""

#: src/Scanner/Rules/LinkToFile.php:141
msgid "Link downloads a file without saying so"
msgstr ""

#: src/Scanner/Rules/LinkToFile.php:152
msgid "This link points at a document rather than a page, and its text does not say so. Following it will start a download or open another application, which is a surprise for anybody and an expensive one for a reader who cannot easily see what just happened. Name the format in the link text — \"Annual report (PDF)\" — so the choice is made before the click, not after."
msgstr ""

#: src/Scanner/Rules/LinkToFile.php:163
msgid "The reader expects a page and gets a download, with no warning and an awkward way back."
msgstr ""

#: src/Scanner/Rules/LinkToFile.php:178
msgid "Add the format to the link text, in the words that suit the sentence it sits in. Adding the file size too is a kindness on a slow connection."
msgstr ""

#. translators: %s: the file format, for example PDF.
#: src/Scanner/Rules/LinkToFile.php:233
#, php-format
msgid "This link opens a %s file and does not say so."
msgstr ""

#. translators: 1: the link text. 2: the file format, for example PDF.
#: src/Scanner/Rules/LinkToFile.php:238
#, php-format
msgid "The link \"%1$s\" opens a %2$s file and does not say so."
msgstr ""

#: src/Scanner/Rules/MainLandmarkMissing.php:87
msgid "Page has no main landmark"
msgstr ""

#: src/Scanner/Rules/MainLandmarkMissing.php:98
msgid "Landmarks let someone using a screen reader jump straight to the content instead of listening through the header and navigation on every page. Wrap the primary content of the page in a main element."
msgstr ""

#: src/Scanner/Rules/MainLandmarkMissing.php:109
msgid "There is no way to skip past the header, so keyboard and screen reader users go through it again on every page."
msgstr ""

#: src/Scanner/Rules/MainLandmarkMissing.php:124
msgid "The landmark has to wrap the page's main content, which is a decision about the template and belongs in the theme."
msgstr ""

#: src/Scanner/Rules/MainLandmarkMissing.php:151
msgid "The page has no main landmark, so there is no quick way to skip to the content."
msgstr ""

#: src/Scanner/Rules/MultipleTopHeadings.php:88
msgid "Page has more than one top-level heading"
msgstr ""

#: src/Scanner/Rules/MultipleTopHeadings.php:99
msgid "A page normally has one h1 naming what the page is about. More than one gives it competing titles and muddles the outline people navigate by. Check whether the extra headings should be h2 instead."
msgstr ""

#: src/Scanner/Rules/MultipleTopHeadings.php:110
msgid "The page says it is about two different things at once, which makes its outline unreliable for anyone navigating by it."
msgstr ""

#: src/Scanner/Rules/MultipleTopHeadings.php:125
msgid "Which of the two should stop being a top-level heading depends on which one the page is actually about."
msgstr ""

#: src/Scanner/Rules/MultipleTopHeadings.php:183
msgid "Your theme appears to put a top-level heading above your content, which would make this one the second on the page. Worth checking on the page itself — if your theme does not, this is fine as it is."
msgstr ""

#. translators: %d: position of this top-level heading on the page.
#: src/Scanner/Rules/MultipleTopHeadings.php:186
#, php-format
msgid "This is top-level heading number %d on the page."
msgstr ""

#: src/Scanner/Rules/PageHasNoHeadings.php:98
msgid "Page has no headings"
msgstr ""

#: src/Scanner/Rules/PageHasNoHeadings.php:109
msgid "There is not a single heading element on this page. Screen reader users navigate long pages by pulling up a list of headings and jumping to the part they want; with none, the only way through is from the top, in order. If the page looks like it has headings, they are probably paragraphs made large and bold — which conveys structure to the eye and nothing to anything else."
msgstr ""

#: src/Scanner/Rules/PageHasNoHeadings.php:120
msgid "There is no way to skim or jump around this page; it can only be read from the top."
msgstr ""

#: src/Scanner/Rules/PageHasNoHeadings.php:135
msgid "Which parts of the page are headings is a judgement about what the page says, and only you can make it. In the editor, change the blocks that act as headings from paragraph to heading."
msgstr ""

#: src/Scanner/Rules/PageHasNoHeadings.php:162
msgid "This page contains no heading elements at all."
msgstr ""

#: src/Scanner/Rules/ReadingLevelHigh.php:123
msgid "Text may be hard to read"
msgstr ""

#: src/Scanner/Rules/ReadingLevelHigh.php:134
msgid "By the Flesch–Kincaid formula this page reads above lower secondary school level, which WCAG 3.1.5 treats as the point where a simpler version or a plain-language summary should be available. Treat this as a prompt rather than a verdict: the formula counts sentence length and syllables and understands nothing, so a page written for a specialist audience may be exactly right as it is."
msgstr ""

#: src/Scanner/Rules/ReadingLevelHigh.php:145
msgid "Readers with a cognitive disability, or reading in a second language, may not get through this page."
msgstr ""

#: src/Scanner/Rules/ReadingLevelHigh.php:160
msgid "Two ways to answer this and both are writing: simplify the page, or add a plain-language summary in the Accessibility panel of the editor. Do not chase the number — shortening sentences until the score drops usually makes the writing worse, and the formula cannot tell."
msgstr ""

#. translators: 1: the estimated reading grade level. 2: the level at which this starts being reported.
#: src/Scanner/Rules/ReadingLevelHigh.php:191
#, php-format
msgid "This page reads at about grade %1$s. Above grade %2$s, WCAG 3.1.5 asks for a simpler version or a summary."
msgstr ""

#: src/Scanner/Rules/TabindexPositive.php:101
msgid "Positive tabindex changes the focus order"
msgstr ""

#: src/Scanner/Rules/TabindexPositive.php:112
msgid "This element has a tabindex above zero, which does not adjust its position slightly — it moves the element into a queue the browser visits before everything else on the page. One of these makes the first Tab press jump past your navigation to land here. Use tabindex=\"0\" to make something focusable in its natural place, and let the order of the markup do the rest."
msgstr ""

#: src/Scanner/Rules/TabindexPositive.php:123
msgid "Tabbing through the page jumps out of order, past everything the reader can see comes first."
msgstr ""

#: src/Scanner/Rules/TabindexPositive.php:138
msgid "Almost always tabindex=\"0\" was what was wanted — focusable, in the order it appears. Confirming that means knowing why the number was put there."
msgstr ""

#. translators: %d: the tabindex value found.
#: src/Scanner/Rules/TabindexPositive.php:173
#, php-format
msgid "This element has tabindex=\"%d\", which moves it ahead of everything else in the tab order."
msgstr ""

#: src/Scanner/Rules/TableHeaderEmpty.php:98
msgid "Table header cell is empty"
msgstr ""

#: src/Scanner/Rules/TableHeaderEmpty.php:109
msgid "This table has a header cell with no text in it. Header cells are what a screen reader announces before each value, so an empty one leaves a whole row or column of data unlabelled — the table looks complete and reads as a list of numbers with no headings. Give the cell text, or make it a plain td if it is not really a header."
msgstr ""

#: src/Scanner/Rules/TableHeaderEmpty.php:120
msgid "A row or column of data is announced with no indication of what it is data about."
msgstr ""

#: src/Scanner/Rules/TableHeaderEmpty.php:135
msgid "What the column or row should be called is a question about what the data means, so the wording is yours. Edit the table in the editor."
msgstr ""

#: src/Scanner/Rules/TableHeaderEmpty.php:175
msgid "This table has a header cell with no text in it."
msgstr ""

#: src/Scanner/Rules/TableHeadersMissing.php:89
msgid "Table has no header cells"
msgstr ""

#: src/Scanner/Rules/TableHeadersMissing.php:100
msgid "If this is a data table, someone using a screen reader cannot tell which column or row a cell belongs to, so the numbers lose their meaning. Mark the header cells up as th with a scope attribute. If the table is only being used for layout, it needs no headers and you can mark this as reviewed."
msgstr ""

#: src/Scanner/Rules/TableHeadersMissing.php:111
msgid "A screen reader reads the cells out one after another, with nothing to say which column or row each one belongs to."
msgstr ""

#: src/Scanner/Rules/TableHeadersMissing.php:126
msgid "Which cells are headers is a statement about what the data means. Guessing would produce a table that reads confidently and wrongly to a screen reader."
msgstr ""

#: src/Scanner/Rules/TableHeadersMissing.php:159
msgid "This table has no header cells. If it presents data rather than layout, its headers need marking up."
msgstr ""

#: src/Scanner/Rules/TextBlinking.php:95
msgid "Content blinks or scrolls on its own"
msgstr ""

#: src/Scanner/Rules/TextBlinking.php:106
msgid "This page uses a blink or marquee element. Both move without being asked and give the reader no way to stop them, which makes surrounding text hard to read for anybody with an attention or reading difficulty, and can be a seizure risk. Neither element is part of HTML any more. Replace it with static text, or with something the reader can pause."
msgstr ""

#: src/Scanner/Rules/TextBlinking.php:117
msgid "Text moves or flashes with no way to stop it, which some readers cannot read past and others cannot safely look at."
msgstr ""

#: src/Scanner/Rules/TextBlinking.php:132
msgid "Whether the content should simply stop moving, or become something the reader can pause, is an editorial decision. Both are edits where the content lives."
msgstr ""

#. translators: %s: the element name, blink or marquee.
#: src/Scanner/Rules/TextBlinking.php:159
#, php-format
msgid "This page uses a %s element, which moves on its own and cannot be stopped."
msgstr ""

#: src/Scanner/Rules/TextJustified.php:96
msgid "Text is justified to both margins"
msgstr ""

#: src/Scanner/Rules/TextJustified.php:107
msgid "This text is set justified, which stretches the spaces between words so each line ends flush. The uneven gaps form rivers of white space running down the paragraph, and for readers with dyslexia those are disorienting enough to make finding the next line difficult. Ranged left is easier to read for everyone and costs nothing."
msgstr ""

#: src/Scanner/Rules/TextJustified.php:118
msgid "Uneven word spacing forms rivers down the paragraph, which some readers find hard to read past."
msgstr ""

#: src/Scanner/Rules/TextJustified.php:133
msgid "Setting this back to ranged left is the whole fix. It is written into the content here rather than into a stylesheet, so it is an edit in the editor."
msgstr ""

#: src/Scanner/Rules/TextJustified.php:173
msgid "This text is justified to both margins, which opens uneven gaps between words."
msgstr ""

#: src/Scanner/Rules/UnderlineNotALink.php:95
msgid "Text is underlined but is not a link"
msgstr ""

#: src/Scanner/Rules/UnderlineNotALink.php:106
msgid "This text is underlined and is not a link. Underlining means \"link\" to most readers, so they will try to click it and find that nothing happens. If the intent was emphasis, em or strong says so to a screen reader as well as to the eye, which an underline does not. There are real uses for the u element — marking a misspelling, for instance — so this is worth a look rather than an automatic change."
msgstr ""

#: src/Scanner/Rules/UnderlineNotALink.php:117
msgid "Readers try to click text that is not a link, and cannot tell whether the page is broken."
msgstr ""

#: src/Scanner/Rules/UnderlineNotALink.php:132
msgid "Whether this was meant as emphasis — in which case em or strong carries it to a screen reader too — or is one of the genuine uses of the u element, is something only the author knows."
msgstr ""

#. translators: %s: the underlined text.
#: src/Scanner/Rules/UnderlineNotALink.php:171
#, php-format
msgid "\"%s\" is underlined but is not a link."
msgstr ""

#: src/Scanner/Rules/VideoNeedsCaptions.php:99
msgid "Video may have no captions"
msgstr ""

#: src/Scanner/Rules/VideoNeedsCaptions.php:110
msgid "This video declares no caption or subtitle track. Captions are what make a video usable with the sound off, which covers far more people than the Deaf and hard-of-hearing audience alone. The markup cannot see burned-in captions or captions supplied by a player, so this is worth confirming rather than assuming — and note that video embedded from YouTube or Vimeo sits inside an iframe, where nothing here can look at all."
msgstr ""

#: src/Scanner/Rules/VideoNeedsCaptions.php:121
msgid "Anybody who cannot hear the video, or has the sound off, gets nothing from it."
msgstr ""

#: src/Scanner/Rules/VideoNeedsCaptions.php:136
msgid "Captions have to be written and timed against the video, which is work no check can do for you. Add a track element pointing at a VTT file, or use a player that supplies them."
msgstr ""

#: src/Scanner/Rules/VideoNeedsCaptions.php:167
msgid "This video declares no caption or subtitle track."
msgstr ""

#: src/Scanner/Rules/ViewportScalingDisabled.php:98
msgid "The page cannot be zoomed"
msgstr ""

#: src/Scanner/Rules/ViewportScalingDisabled.php:109
msgid "This page's viewport tag stops pinch-zoom, or caps it below twice the normal size. Readers with low vision rely on zooming to read at all, and this takes that away on exactly the devices where it matters most. Remove user-scalable=no and any maximum-scale below 2 — the browser behaviour these were once working around no longer exists."
msgstr ""

#: src/Scanner/Rules/ViewportScalingDisabled.php:120
msgid "Readers who need larger text cannot enlarge the page on a phone or tablet."
msgstr ""

#: src/Scanner/Rules/ViewportScalingDisabled.php:135
msgid "The viewport tag is printed in the theme's head, so this is a one-line change there rather than anything in your content: drop user-scalable=no and any maximum-scale below 2."
msgstr ""

#: src/Scanner/Rules/ViewportScalingDisabled.php:163
msgid "zooming is switched off"
msgstr ""

#. translators: %s: the maximum-scale value found.
#: src/Scanner/Rules/ViewportScalingDisabled.php:169
#, php-format
msgid "zooming stops at %s times"
msgstr ""

#. translators: %s: what the viewport tag does, already phrased.
#: src/Scanner/Rules/ViewportScalingDisabled.php:185
#, php-format
msgid "The viewport tag means %s, so the page cannot be enlarged to twice its size."
msgstr ""

#: src/Scanner/Rules/ViewportScalingDisabled.php:186
msgid " and "
msgstr ""

#: src/Scanner/ScanCoverage.php:76
msgid "Content checked"
msgstr ""

#: src/Scanner/ScanCoverage.php:77
msgid "Fully checked"
msgstr ""

#: src/Scanner/ScanCoverage.php:90
msgid "Nothing has looked at this page yet."
msgstr ""

#: src/Scanner/ScanCoverage.php:91
msgid "The words and markup of this page were checked. Colour, text size and layout were not — those need the page open in a browser, which a background run cannot do. Open it in the inspector to check the rest."
msgstr ""

#: src/Scanner/ScanCoverage.php:92
msgid "Both passes ran: the markup, and the page as a browser actually draws it."
msgstr ""

