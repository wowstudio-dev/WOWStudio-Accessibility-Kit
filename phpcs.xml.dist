<?xml version="1.0"?>
<ruleset name="WOWStudio Accessibility Kit">
	<description>WordPress Coding Standards for the WOWStudio Accessibility Kit plugin.</description>

	<!-- What to scan. -->
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- The release build is a copy of src/; scanning it double-reports every class. -->
	<exclude-pattern>*/dist/*</exclude-pattern>
	<!-- Static-analysis stubs, mirroring a third-party API we do not control. -->
	<exclude-pattern>*/stubs/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<!-- How to run. -->
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<!-- Minimum supported versions. Trial/tier decisions live in SPEC.md; these are the code floors. -->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<!--
		PHPCompatibility's stable release (9.3.5) predates PHP 8.1 enums and does
		not recognise an enum as an object scope, so it reports every
		"match ( $this )" inside an enum method as $this used outside an object.
		These are false positives, not findings. Remove this exclusion once
		PHPCompatibility 10 is stable; see docs/RELEASE-CHECKLIST.md.
	-->
	<rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
		<severity>0</severity>
	</rule>

	<!--
		PSR-4 autoloading uses StudlyCaps class files (src/Core/Plugin.php), which is
		incompatible with WPCS's class-my-thing.php convention. SPEC.md mandates PSR-4,
		so the filename sniff is dropped rather than the autoloader.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/src/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Every global symbol must carry the project prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wsak"/>
				<element value="WSAK"/>
				<element value="WOWStudio\AccessibilityKit"/>
			</property>
		</properties>
	</rule>

	<!--
		The DOM extension's property names are fixed by PHP. They are not ours to
		rename, and the sniff has no way to know that.
	-->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="nodeName"/>
				<element value="nodeValue"/>
				<element value="nodeType"/>
				<element value="textContent"/>
				<element value="parentNode"/>
				<element value="childNodes"/>
				<element value="firstChild"/>
				<element value="ownerDocument"/>
				<element value="documentElement"/>
				<element value="numFiles"/>
			</property>
		</properties>
	</rule>

	<!-- All user-facing strings use the plugin text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wowstudio-accessibility-kit"/>
			</property>
		</properties>
	</rule>

	<!-- Tests are not WordPress runtime code. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
